# Digital Lab · reglas del servidor para Hostinger (dl-dev.com)
# Hostinger ya redirige http → https; aquí solo se unifica el dominio y se mejora la caché.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.dl-dev.com → dl-dev.com (una sola dirección para Google)
  RewriteCond %{HTTP_HOST} ^www\.dl-dev\.com$ [NC]
  RewriteRule ^(.*)$ https://dl-dev.com/$1 [L,R=301]

  # /index.html → / (evita contenido duplicado)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://dl-dev.com/ [L,R=301]
</IfModule>

# Archivos internos que nunca deben servirse (por si se suben por error)
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(git|svn|claude|vscode)(/|$) - [F,L]
  RewriteRule \.(md|bak|log|sql|sh|py|env)$ - [F,L,NC]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  # Siempre HTTPS durante un año (sin subdominios: actívalo solo si todos usan HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Qué puede cargar la página: solo recursos propios; WhatsApp se abre como enlace, no se incrusta
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
</IfModule>

# Tipos de archivo
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# Caché: el HTML siempre se revalida; CSS y JS llevan ?v= en la página, así que pueden guardarse mucho tiempo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/manifest+json application/xml text/xml
</IfModule>
